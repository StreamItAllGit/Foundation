<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Foundation.UI</AssemblyName>
    <RootNamespace>Foundation.UI</RootNamespace>
    <Title>Foundation Shared UI Shell, DesktopHost Controls &amp; Schema Contracts</Title>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundation.Core\Foundation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="WebAssets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="SyncFoundationWebAndSharedLibs" AfterTargets="Build">
    <ItemGroup>
      <_FoundationWebSourceFiles Include="$(MSBuildProjectDirectory)\Web\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FoundationWebSourceFiles)"
          DestinationFiles="@(_FoundationWebSourceFiles->'$(MSBuildProjectDirectory)\WebAssets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FoundationWebSourceFiles)"
          DestinationFiles="@(_FoundationWebSourceFiles->'$(MSBuildProjectDirectory)\WebAssets\Web\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Exec Condition="'$(Configuration)' == 'Release'"
          Command="python &quot;$(MSBuildProjectDirectory)\..\..\tools\sync_foundation_sdk.py&quot; --version 0.3.0 --ui-version 0.2.0 --configuration $(Configuration)" />
  </Target>
</Project>
