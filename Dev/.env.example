# Foundation SDK Environment Overlay Example
# Copy to .env (gitignored) or set in your shell / <dataDir> environment.

# Optional override for SharedLibs output root (defaults to ../../SharedLibs/Foundation relative to repo)
FOUNDATION_SHARED_LIBS_ROOT=

# Optional data directory override for isolated/local overlays
FOUNDATION_DATA_DIR=

# Optional Notion Task Backbone & Projects Hub IDs (for notion_task_helper.py)
FOUNDATION_NOTION_TASK_BACKBONE_ID=
FOUNDATION_NOTION_PROJECTS_HUB_ID=

# Optional Stage 2 External 4-Drive Sandbox Overrides (Standard 02 §4 & Standard 25 §1.4)
# Workstation values normally live in %USERPROFILE%\.gemini\.secrets\.env or gitignored Dev\.env.
FOUNDATION_SANDBOX_ROOT=
FOUNDATION_SANDBOX_PROFILE_DIR=
SANDBOX_C_DRIVE=
SANDBOX_D_DRIVE=
SANDBOX_REMOVABLE_DRIVE=
SANDBOX_DISC_DRIVE=
