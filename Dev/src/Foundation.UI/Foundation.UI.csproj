<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Foundation.UI</AssemblyName>
    <RootNamespace>Foundation.UI</RootNamespace>
    <Title>Foundation Shared UI Shell, DesktopHost Controls &amp; Schema Contracts</Title>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundation.Core\Foundation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="WebAssets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="Web\**\*.*" Link="WebAssets\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="SyncFoundationWebAndSharedLibs" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(PublishFoundationSdk)' == 'true'">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\..\tools\sync_foundation_sdk.py&quot; --version 0.4.1-hf.1 --ui-version 0.4.1-hf.1 --configuration $(Configuration) --publish" />
  </Target>
</Project>
